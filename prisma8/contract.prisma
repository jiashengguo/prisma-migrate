// use prisma-8
// Printed from prisma/schema.prisma by `prisma contract print`.

namespace public {
  model User {
    id        Int                @id @default(autoincrement())
    email     String
    name      String?
    bio       String?
    createdAt TimestampString(3) @default(now()) @onCreate(now())
    posts     Post[]

    @@index([email], map: "User_email_key", unique: true)
  }

  model Post {
    id        Int     @id @default(autoincrement())
    title     String
    published Boolean @default(false)
    authorId  Int
    author    User    @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    @@index([authorId], map: "Post_authorId_idx")
  }
}
